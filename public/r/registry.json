      "registryDependencies": ["popover", "sheet"],
      "files": [
        { "path": "registry/ui/hotspot-image.tsx", "type": "registry:ui" },
        { "path": "registry/ui/hotspot-pin.tsx", "type": "registry:ui" },
        { "path": "registry/ui/types.ts", "type": "registry:ui" }
      ]
